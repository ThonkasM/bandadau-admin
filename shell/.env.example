# Todo NEXT_PUBLIC_* es público (se incrusta en el bundle): nada de secretos aquí.
# Uso normal: Traefik en http://admin.bandada.localhost (misma "site" que api.bandada.localhost,
# imprescindible para la cookie SameSite=Strict del refresh token).
NEXT_PUBLIC_API_URL=http://api.bandada.localhost
NEXT_PUBLIC_GRAPHQL_URL=http://api.bandada.localhost/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=ws://api.bandada.localhost/graphql
NEXT_PUBLIC_APP_URL=http://app.bandada.localhost
NEXT_PUBLIC_MFE_MANIFEST_URL=/mfe-manifest.json
NEXT_PUBLIC_DEFAULT_LOCALE=es
# Feature flag: "Insights/Reportes" (fase 2). Con false se muestra la tarjeta "Disponible en fase 2".
NEXT_PUBLIC_FEATURE_INSIGHTS=false
