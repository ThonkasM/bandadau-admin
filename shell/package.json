{
  "name": "admin-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Bandada U admin panel shell and microfrontend host (Next.js 16 static export)",
  "packageManager": "pnpm@10.34.7",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/i18n-check.mjs",
    "mock": "node dev-mock/server.mjs",
    "manifest:prod": "node scripts/write-manifest.mjs"
  },
  "dependencies": {
    "@bandada/contracts-ts": "file:../../bandadau-shared/packages/contracts-ts",
    "@bandada/i18n": "file:../../bandadau-shared/packages/i18n",
    "@bandada/ui-tokens": "file:../../bandadau-shared/packages/ui-tokens",
    "@urql/core": "^6.0.0",
    "@urql/exchange-auth": "^3.0.0",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.4.0",
    "i18next": "^26.4.5",
    "i18next-icu": "^2.5.0",
    "intl-messageformat": "^12.1.3",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.16",
    "urql": "^5.0.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@bandada/eslint-config": "file:../../bandadau-shared/packages/eslint-config",
    "@bandada/tsconfig": "file:../../bandadau-shared/packages/tsconfig",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4",
    "ws": "^8.18.3"
  }
}
