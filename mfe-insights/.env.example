# Solo informativo: en el shell todo llega por propiedades/atributos del elemento.
# En modo standalone el host de prueba usa ?gql=<url> (por defecto http://localhost:4011/graphql, el mock propio).
# Contra la infraestructura viva: ?gql=http://api.bandada.localhost/graphql (token de admin vía /api/v1/auth/login).
VITE_GRAPHQL_URL=http://api.bandada.localhost/graphql
VITE_DEFAULT_LOCALE=es
