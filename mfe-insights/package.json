{
  "name": "mfe-insights",
  "version": "0.1.2",
  "description": "Microfrontend de insights de Bandada U: <bandada-mfe-insights> (React 19 + Vite library mode)",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "test": "vitest run && node scripts/check-contract.mjs",
    "lint": "eslint . && node scripts/check-style-rules.mjs",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "mock": "node dev/mock-gateway.mjs"
  },
  "dependencies": {
    "@bandada/contracts-ts": "file:../../bandadau-shared/packages/contracts-ts",
    "@bandada/i18n": "file:../../bandadau-shared/packages/i18n",
    "@bandada/ui-tokens": "file:../../bandadau-shared/packages/ui-tokens",
    "dompurify": "^3.4.17",
    "graphql-ws": "^6.4.0",
    "i18next": "^26.4.5",
    "i18next-icu": "^2.5.0",
    "intl-messageformat": "^12.1.3",
    "marked": "^18.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.16",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0"
  },
  "devDependencies": {
    "@bandada/eslint-config": "file:../../bandadau-shared/packages/eslint-config",
    "@bandada/tsconfig": "file:../../bandadau-shared/packages/tsconfig",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "graphql": "^16.14.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "ws": "^8.22.0"
  }
}
